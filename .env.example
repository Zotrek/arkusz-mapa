# ID arkusza Google Sheets (np. z URL: .../d/TEN_ID/edit)
GOOGLE_SHEETS_ID=1X-hNus0LrQf2ZXrb4nsHXfYOT5WBR-q3vN7TDAfxLzI

# Ścieżka do pliku JSON Service Account (klucz z Google Cloud Console)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Folder, do którego zapisywane są wygenerowane pliki mapy HTML
OUTPUT_DIR=./output

# Rejestr transportów (osobny arkusz) — Web App z google-apps-script/transport-log.gs
# GOOGLE_TRANSPORT_SHEETS_ID=1hvSvy9c069SefhYH3rCUDtCViRhAoRQ6DDj_EIlmWNk
# TRANSPORT_WEBAPP_URL=https://script.google.com/macros/s/…/exec
# Słowniki (Przewoźnicy, Miejsca dostawy, Popraw adres) — ten sam arkusz / Web App. Zob. docs/REFERENCE_SHEET.md

# Opcjonalnie: lista podwykonawców (.xlsx / .ods). Domyślnie: ./docs/podwyko lista.xlsx
# PODWYKOLISTA_ODS_PATH=./docs/podwyko lista.ods

# Cache geokodowania (JSON). Domyślnie: ./data/phase5-cache.json (wspólny z repo / seed CI).
# GitHub Actions nadpisuje na .cache/phase5-cache.json (Actions cache).
# PHASE5_CACHE_PATH=./data/phase5-cache.json

# Kopiuj kwalifikujące się plomby maszynowe z harmonogramem do zakładki „odebrane z harmonogramu”.
# Domyślnie wyłączone. Włącz: 1 / true / yes / tak (workflow „Pages + odebrane” ustawia 1).
# COPY_ODEBRANE_Z_HARMONOGRAMU=1

# Cel zapisu „odebrane z harmonogramu” — ewidencja odbiorów (NIE trasówki).
# Domyślnie: ten sam arkusz co rejestr transportów (1hvSvy9c…). Override:
# GOOGLE_EWIDENCJA_ODBIOROW_SHEETS_ID=1hvSvy9c069SefhYH3rCUDtCViRhAoRQ6DDj_EIlmWNk
